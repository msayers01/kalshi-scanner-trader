# Copy to .env and fill in. Never commit .env.
# Nested settings use double underscores: KST_<SECTION>__<KEY>

# --- Kalshi API (https://kalshi.com/account/profile → API Keys). Ed25519 or RSA key.
KST_KALSHI__KEY_ID=
KST_KALSHI__PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem

# --- Web UI control token (required if web.host is not 127.0.0.1)
KST_WEB__API_TOKEN=

# --- Discord bot (https://discord.com/developers/applications → Bot → Token)
KST_DISCORD__ENABLED=false
KST_DISCORD__TOKEN=
KST_DISCORD__GUILD_ID=
KST_DISCORD__CHANNEL_ID=
# JSON list of Discord user IDs allowed to press controls
KST_DISCORD__ALLOWED_USER_IDS=[]

# --- LLM (local Ollama needs no key). For cloud escalation, e.g. Anthropic:
# KST_LLM__ESCALATION__KIND=anthropic
# KST_LLM__ESCALATION__BASE_URL=https://api.anthropic.com
# KST_LLM__ESCALATION__MODEL=claude-haiku-5-5
# KST_LLM__ESCALATION__API_KEY=
# KST_LLM__ESCALATE_ON_UNAVAILABLE=true

# --- NWS API asks for a contact in the User-Agent
# KST_FEEDS__WEATHER__USER_AGENT=kst-weather (you@example.com)
